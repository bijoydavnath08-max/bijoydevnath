# Copy this file to .env and fill in real values before deploying.

# The login you'll use in the site's admin panel.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# Any long random string - used to sign login tokens.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# How many days a login stays valid before you have to sign in again.
JWT_EXPIRY_DAYS=7

# Port the server listens on (most hosts set this for you automatically).
PORT=5000
